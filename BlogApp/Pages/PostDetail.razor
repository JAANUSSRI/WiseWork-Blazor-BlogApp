@* Path: BlogApp/Pages/PostDetail.razor *@
@page "/post/{PostId}"
@inject Services.AuthService AuthService
@inject Services.PostService PostService
@inject Services.CommentService CommentService
@inject NavigationManager NavigationManager
@using System.ComponentModel.DataAnnotations
@using BlogApp.Models

@if (post == null)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="post-card comment-post">
        <h3>@post.Title</h3>
        <div class="post-content">@post.Content</div>
        <div class="post-meta">
            <span>By @post.AuthorEmail</span>
            <span>@post.CreatedAt.ToShortDateString()</span>
        </div>
    </div>

    <div class="comments-section mt-4">

        @if (user != null)
        {
            <div class="add-comment mt-4">
                <h5>Add a Comment</h5>
                <EditForm Model="newComment" OnValidSubmit="HandleSubmit">
                    <div class="form-group mb-3">
                        <InputTextArea class="form-control" @bind-Value="newComment.Content" rows="3"
                                       placeholder="Write your comment here..." />
                        <ValidationMessage For="@(() => newComment.Content)" />
                    </div>
                    <button type="submit" class="btn btn-primary">Post Comment</button>
                </EditForm>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4">
                Please <a href="/login">login</a> to post a comment.
            </div>
        }

        <hr />

        <h4>Comments</h4>

        @if (comments == null)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!comments.Any())
        {
            <p>No comments yet. Be the first to comment!</p>
        }
        else
        {
            <div class="comments-list">
                @foreach (var comment in comments)
                {
                    <div class="comment-card mb-3 p-3 border rounded">
                        <div class="comment-meta d-flex justify-content-between">
                            <span class="fw-bold">@comment.UserEmail</span>
                            <span class="text-muted">@comment.CreatedAt.ToString("g")</span>
                        </div>
                        <div class="comment-content mt-2">@comment.Content</div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string PostId { get; set; }

    private Post? post;
    private List<Comment>? comments;
    private Supabase.Gotrue.User? user;
    private CommentModel newComment = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        user = await AuthService.GetUser();
        post = await PostService.GetPostAsync(PostId);
        comments = await CommentService.GetCommentsAsync(PostId);
    }

    private async Task HandleSubmit()
    {
        if (user != null && !string.IsNullOrWhiteSpace(newComment.Content))
        {
            await CommentService.CreateCommentAsync(
                PostId,
                user.Id,
                user.Email ?? string.Empty,
                newComment.Content);

            newComment.Content = string.Empty;
            await LoadData(); // Refresh comments
        }
    }

    private class CommentModel
    {
        [Required(ErrorMessage = "Comment cannot be empty")]
        [MinLength(1, ErrorMessage = "Comment cannot be empty")]
        public string Content { get; set; } = string.Empty;
    }
}